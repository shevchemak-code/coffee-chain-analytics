# LLM provider configuration — copy to .env and fill in, or export these vars

# Which provider drives the AI features
LLM_PROVIDER=anthropic            # anthropic | openai

# API key for the chosen provider (the app also reads the standard var names directly)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model override; defaults are small/cheap/fast models
# LLM_MODEL=claude-haiku-4-5-20251001
# LLM_MODEL=gpt-4o-mini
